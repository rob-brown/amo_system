```elixir
calculate_resolution = fn ->
  case Vision.Native.capture_raw() do
    {:ok, %Evision.Mat{shape: {h, w, _depth}}} ->
      "#{w}x#{h}"

    {:error, reason} ->
      Logger.error("Failed to capture image #{inspect(reason)}")

      # Fallback to initial resolution.
      resolution
  end
end

SquadStrike.resume(storage, calculate_resolution)
```

